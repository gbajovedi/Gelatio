  {
    "id": "prep_variegato_de_cocada",
    "name": "Variegato de Cocada",
    "category": "Variegato",
    "instructions": "Caramelizar o açúcar. Após, adicionar o coco ralado e misturar. Adicionar o resto dos ingredientes e reduzir em fogo baixo. Somente adicionar o coco em tiras próximo do final.",
    "preparationSteps": [
      {
        "id": "step_cocada_1",
        "order": 1,
        "title": "Caramelização Seca do Açúcar",
        "category": "aquecimento",
        "temperature": "165°C",
        "duration": "8 min",
        "description": "Colocar o açúcar em panela de fundo grosso e derreter em fogo médio-baixo até formar um caramelo dourado brilhante uniforme, sem queimar."
      },
      {
        "id": "step_cocada_2",
        "order": 2,
        "title": "Tostagem do Coco Ralado no Caramelo",
        "category": "aquecimento",
        "temperature": "120°C",
        "duration": "3 min",
        "description": "Adicionar o coco ralado fino ao caramelo ainda quente, mexendo rapidamente com colher de silicone para tostar levemente e impregnar o aroma amanteigado do coco."
      },
      {
        "id": "step_cocada_3",
        "order": 3,
        "title": "Adição de Líquidos e Redução em Fogo Baixo",
        "category": "aquecimento",
        "temperature": "95°C",
        "duration": "15 min",
        "description": "Adicionar com cuidado os líquidos restantes (leite/água) e cozinhar em fogo baixo, mexendo sempre, até que o caramelo dissolva e a cocada engrosse em ponto de doce cremoso de colher."
      },
      {
        "id": "step_cocada_4",
        "order": 4,
        "title": "Finalização com Fitas de Coco & Resfriamento",
        "category": "mesclagem",
        "temperature": "Ambiente",
        "duration": "10 min",
        "description": "Nos últimos minutos de cozimento, adicionar o coco em fitas/tiras para conferir textura mastigável e contraste visual no gelato. Desligar o fogo e deixar esfriar antes de utilizar na mesclagem."
      }
    ],
    "ingredients": [
      {
        "name": "Coco",
        "grams": 300
      },
      {
        "name": "Coco Ralado Seco",
        "grams": 100
      },
      {
        "name": "Açúcar",
        "grams": 300
      },
      {
        "name": "Glucose Líquida",
        "grams": 150
      },
      {
        "name": "Água",
        "grams": 100
      },
      {
        "name": "Leite Condensado",
        "grams": 100
      },
      {
        "name": "Dextrose",
        "grams": 50
      },
      {
        "name": "Manteiga",
        "grams": 15
      },
      {
        "name": "Sal",
        "grams": 2
      },
      {
        "name": "Suco de Limão",
        "grams": 20
      }
    ]
