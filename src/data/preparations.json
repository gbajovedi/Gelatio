  {
    "id": "prep_variegato_de_nutella",
    "name": "Variegato de Nutella",
    "category": "Variegato",
    "instructions": "1. Aqueça o creme de leite junto com a glucose, o sal (e o cacau, se usar) em uma panela até atingir cerca de 80°C (início de fervura).\n2. Despeje a mistura quente sobre a Nutella em um recipiente.\n3. Deixe descansar por 1 minuto para o calor amolecer a Nutella.\n4. Utilize um mixer de imersão por alguns minutos até obter uma emulsão lisa, brilhante e homogênea.\n5. Deixe esfriar completamente antes de utilizar para mesclar no gelato.",
    "preparationSteps": [
      {
        "id": "step_nutella_1",
        "order": 1,
        "title": "Aquecimento dos Líquidos",
        "category": "aquecimento",
        "temperature": "80°C",
        "duration": "5 min",
        "description": "Aqueça o creme de leite junto com a glucose e o sal (e o cacau, se usar) em uma panela até atingir cerca de 80°C (início de fervura leve), dissolvendo a glucose por completo."
      },
      {
        "id": "step_nutella_2",
        "order": 2,
        "title": "Fusão Térmica sobre a Nutella",
        "category": "outro",
        "temperature": "80°C",
        "duration": "1 min",
        "description": "Despeje a mistura quente diretamente sobre a Nutella em um bowl de inox ou vidro temperado. Deixe descansar por 1 minuto sem mexer para o calor amolecer a massa de avelãs e cacau."
      },
      {
        "id": "step_nutella_3",
        "order": 3,
        "title": "Emulsão com Mixer de Imersão",
        "category": "emulsao",
        "temperature": "60°C",
        "duration": "3 min",
        "description": "Posicione o mixer de imersão no fundo do recipiente sem levantar a lâmina para não incorporar bolhas de ar. Processe por cerca de 2 a 3 minutos até obter uma ganache/emulsão lisa, brilhante e sedosa."
      },
      {
        "id": "step_nutella_4",
        "order": 4,
        "title": "Resfriamento e Estabilização da Textura",
        "category": "maturacao",
        "temperature": "20°C",
        "duration": "1h",
        "description": "Deixe a mescla esfriar completamente em temperatura ambiente fresca até atingir cerca de 20°C e viscosidade elástica própria para intercalar no gelato."
      },
      {
        "id": "step_nutella_5",
        "order": 5,
        "title": "Armazenamento e Aplicação no Gelato",
        "category": "mesclagem",
        "temperature": "20°C",
        "duration": "Uso imediato",
        "description": "Armazenar em bisnaga ou pote hermético em temperatura ambiente. Aplicar em fios e colheradas durante a extração do gelato na cuba ou pote."
      }
    ],
    "ingredients": [
      {
        "name": "Nutella",
        "grams": 750
      },
      {
        "name": "Creme De Leite Fresco 35%",
        "grams": 400
      },
      {
        "name": "Glucose Líquida",
        "grams": 80
      },
      {
        "name": "Açúcar Invertido",
        "grams": 60
      },
      {
        "name": "Sal",
        "grams": 3
      },
      {
        "name": "Cacau Em Pó 11% gordura",
        "grams": 5
      }
    ]
  }
