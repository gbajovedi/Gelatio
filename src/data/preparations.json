[
  {
    "id": "prep_pudim",
    "name": "Pudim",
    "category": "Pré-preparo",
    "instructions": "Assar por 1h50m a 180 graus. Cobrir com papel alumínio e colocar uma assadeira com água embaixo. Usar açúcar cristal para fazer o caramelo.",
    "preparationSteps": [
      {
        "id": "step_pudim_1",
        "order": 1,
        "title": "Caramelo na Forma",
        "category": "aquecimento",
        "temperature": "165°C",
        "duration": "10 min",
        "description": "Em fogo brando, derreter o açúcar cristal diretamente na forma com furo central (ou em panela) até formar um caramelo dourado homogêneo. Espalhar cuidadosamente pelas paredes e pelo cone central da forma. Deixar esfriar até endurecer."
      },
      {
        "id": "step_pudim_2",
        "order": 2,
        "title": "Homogeneização da Mistura",
        "category": "emulsao",
        "temperature": "Ambiente",
        "duration": "3 min",
        "description": "Peneirar as gemas e ovos para retirar a película. Juntar o leite condensado e o leite integral. Misturar delicadamente com fuê ou pulsar brevemente no liquidificador em baixa rotação para não incorporar ar excessivo. Verter com cuidado na forma caramelizada."
      },
      {
        "id": "step_pudim_3",
        "order": 3,
        "title": "Cocção no Forno em Banho-Maria",
        "category": "aquecimento",
        "temperature": "180°C",
        "duration": "1h 50 min",
        "description": "Cobrir a forma hermeticamente com papel alumínio (face brilhante voltada para dentro). Posicionar dentro de uma assadeira com água fervente (banho-maria). Assar em forno pré-aquecido a 180°C por cerca de 1 hora e 50 minutos até que o centro esteja firme com leve balanço gelatinoso."
      },
      {
        "id": "step_pudim_4",
        "order": 4,
        "title": "Resfriamento e Desenforme Seguro",
        "category": "maturacao",
        "temperature": "4°C",
        "duration": "6h a 12h",
        "description": "Retirar do forno e deixar amornar em temperatura ambiente por 1 hora. Levar à geladeira por no mínimo 6 horas (idealmente pernoite). Antes de desenformar, aquecer o fundo da forma rapidamente na chama do fogão por 15 segundos para soltar o caramelo. Desenformar sobre prato de bordas altas."
      }
    ],
    "ingredients": [
      {
        "name": "Ovo Galinha",
        "grams": 350
      },
      {
        "name": "Leite Condensado",
        "grams": 800
      },
      {
        "name": "Leite Integral",
        "grams": 800
      },
      {
        "name": "Açúcar",
        "grams": 160
      }
    ]
  },
